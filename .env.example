# Copy to .env for local overrides. Each service reads its own prefix.

# Shared defaults (set per service via prefix, e.g. CATALOG_LOG_LEVEL)
# <PREFIX>_ENVIRONMENT=local      # local | dev | staging | prod
# <PREFIX>_LOG_LEVEL=INFO
# <PREFIX>_LOG_JSON=false

# gateway
GATEWAY_CATALOG_URL=http://localhost:8001
GATEWAY_CONTENT_URL=http://localhost:8002
GATEWAY_STUDY_URL=http://localhost:8003

# catalog
CATALOG_CORPUS_PATH=data/build/corpus.db

# content
CONTENT_DB_PATH=data/content.db
CONTENT_CATALOG_URL=http://localhost:8001

# study
STUDY_DB_PATH=data/study.db
# STUDY_BACKUP_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/hortum-backups

# pipeline
# Wikimedia refuses requests without contact details (a URL or email) in the User-Agent.
PIPELINE_WIKIMEDIA_USER_AGENT="hortum-et-bibliotheca/0.1 (https://github.com/<you>/hortum-et-bibliotheca; <you>@example.com)"
# PIPELINE_REVIEW_THRESHOLD=0.8

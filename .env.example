# Copy to .env for local overrides. Each service reads its own prefix.

# Shared defaults (set per service via prefix, e.g. SERVICE_A_LOG_LEVEL)
# <PREFIX>_ENVIRONMENT=local      # local | dev | staging | prod
# <PREFIX>_LOG_LEVEL=INFO
# <PREFIX>_LOG_JSON=false

# gateway
GATEWAY_SERVICE_A_URL=http://localhost:8001
GATEWAY_SERVICE_B_URL=http://localhost:8002

# service-b
SERVICE_B_SERVICE_A_URL=http://localhost:8001
